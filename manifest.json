{
  "manifest_version": 3,
  "name": "Telegram → Facebook 群消息转发",
  "version": "2.0.2",
  "description": "Telegram 群消息静默转发到 Facebook Messenger；纯后台 API，无需打开群聊页",
  "permissions": ["storage", "tabs", "alarms", "notifications", "scripting", "cookies"],
  "host_permissions": [
    "https://web.telegram.org/*",
    "https://*.facebook.com/*",
    "https://facebook.com/*",
    "https://docs.google.com/*",
    "https://upload.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TG→FB 转发"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*"
      ],
      "js": ["image-dedupe.js", "telegram-react-bridge.js", "telegram-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
